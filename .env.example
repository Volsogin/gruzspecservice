# Скопируйте в .env и заполните. .env НЕ коммитится.
# Пустое значение = интеграция выключена, работает dev-фолбэк (см. docs/ARCHITECTURE.md).

# --- общее ---
APP_ENV=dev
# Только для сервера (`make prod-up`): домен, на который Caddy выпустит HTTPS. Сайт и API — на нём же
# DOMAIN=ваш-домен.ru
# Адрес сайта: из него строятся ссылки /order/{token} в письмах и Telegram.
# Разработка (`make web`): http://localhost:5173; `make preview`/Docker: http://localhost:8000; сервер: https://ваш-домен.ru
PUBLIC_BASE_URL=http://localhost:5173
# Публичный адрес API: из него строятся ссылки на фото (/media/...). На сервере — тот же https://ваш-домен.ru
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Длинная случайная строка: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Пусто → генерируется при старте (form_token и сессия админки сбросятся при перезапуске)
SECRET_KEY=
LOG_LEVEL=INFO
LOG_JSON=true

# --- БД: make dev → SQLite в backend/var/dev.db; docker compose задаёт Postgres сам ---
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/gruzspec
POSTGRES_PASSWORD=gruzspec_local_dev
# docker compose: на сервере за Caddy — API_BIND=127.0.0.1 и FORWARDED_ALLOW_IPS=* (см. docs/EMAIL_AND_DOMAIN.md)
API_BIND=0.0.0.0
FORWARDED_ALLOW_IPS=127.0.0.1

# --- админка /admin и /api/v1/admin/* (пароль = этот токен; пусто → админка выключена) ---
ADMIN_TOKEN=

# --- адресаты уведомлений оператору (БЕЗ дефолтов: тестовые заявки не уйдут по реквизитам сайта) ---
OPERATOR_EMAIL=
# Код приглашения операторов: оператор пишет боту `/operator <код>` и получает заявки в личку.
# Пусто → регистрация выключена. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(9))"
OPERATOR_INVITE_CODE=
# Запасной общий чат операторов (группа, отрицательный id; узнать: /chatid в группе) — сюда идут заявки,
# когда ни один оператор не на смене.
OPERATOR_TG_CHAT_ID=

# --- SMTP (SMTP_HOST пуст → письма сохраняются в backend/var/mail/*.eml) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=ГРУЗСПЕЦСЕРВИС <no-reply@example.ru>

# --- Telegram-бот (токен от @BotFather; пусто → уведомления пишутся в лог) ---
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
# polling — демо/разработка; webhook — прод (нужны HTTPS и TELEGRAM_WEBHOOK_SECRET)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# Прокси ТОЛЬКО для Telegram (если api.telegram.org недоступен/тормозит). Примеры для v2rayN/xray:
#   make dev:          http://127.0.0.1:10809   или   socks5://127.0.0.1:10808
#   docker compose up: http://host.docker.internal:10809  (и в v2rayN разрешить подключения из LAN)
TELEGRAM_PROXY_URL=

# --- Max (заглушка, см. ARCHITECTURE.md) ---
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=

# --- ИИ-ассистент: OpenRouter (пусто → FAQ-режим без LLM) ---
OPENROUTER_API_KEY=
# OpenRouter отвечает 403 на российские IP: на ноутбуке в РФ — прокси v2rayN (http://127.0.0.1:10809), на сервере за рубежом — пусто
LLM_PROXY_URL=
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_FALLBACK_MODELS=google/gemini-2.5-flash-lite
LLM_MAX_TOKENS=400
LLM_DAILY_REQUEST_LIMIT=400
LLM_DAILY_TOKEN_LIMIT=400000
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_MAX_MESSAGES_PER_SESSION=40
CHAT_OPERATOR_WAIT_MINUTES=10

# --- 2ГИС ---
# Серверный ключ Places/Catalog: геокодер /geo/* и проверка адресов в чате (пусто → /geo/* отвечает 501)
DGIS_API_KEY=
# Ключ MapGL для карты в браузере. Он публичный (уходит в браузер через /settings/public) —
# ограничьте его своим доменом в кабинете 2ГИС. Можно тот же ключ, что выше. Пусто → схематичная заглушка карты
DGIS_MAPGL_KEY=
# ID стиля карты из Редактора стилей 2ГИС (скопируйте ночную тему → Share → ID).
# Пусто → стандартная карта, затемнённая на сайте фильтром под тёмную тему
# DGIS_MAP_STYLE=

# --- анти-спам ---
FORM_TOKEN_REQUIRED=false
FORM_MIN_FILL_SECONDS=3
RATE_LIMIT_ENABLED=true

# --- опционально: раздавать собранный фронт этим же сервером (/ с fallback на index.html) ---
# FRONTEND_DIST_DIR=/abs/path/to/frontend/dist
