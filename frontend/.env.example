# Обычно ничего менять не нужно: фронт ходит в API по относительному пути /api/v1
# (в dev — через прокси Vite на :8000, в проде — тот же домен).
# VITE_API_URL=/api/v1
# Куда проксировать /api и /media в `npm run dev`:
# DEV_API_TARGET=http://127.0.0.1:8000
# Ключ 2ГИС MapGL фронт берёт из бэкенда (GET /settings/public → maps.mapgl_key, переменная DGIS_MAPGL_KEY).
